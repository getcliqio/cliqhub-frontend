{
  "name": "@getcliqio/cliqhub-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:orgs-copy": "node scripts/check_orgs_copy.mjs",
    "check:rerun-copy": "node scripts/check_rerun_copy.mjs",
    "test:sync": "npm test --prefix services/sync",
    "db:schema": "tsx scripts/db.ts schema",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx seed/seed.ts",
    "db:bootstrap": "tsx seed/bootstrap.ts",
    "db:setup": "npm run db:schema && npm run db:migrate && npm run db:bootstrap",
    "db:reset": "tsx scripts/db.ts reset",
    "prod:agents:seed": "bash scripts/seed_agents_railway.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@xyflow/react": "^12.10.1",
    "bcryptjs": "^2.4.3",
    "codemirror": "^6.0.2",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.14.2",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "9.39.4",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getcliqio/cliqhub-frontend.git"
  }
}
